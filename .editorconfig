root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,xml}]
indent_size = 4

[*.{yml,yaml,json,js,css,html}]
indent_size = 2

[*.{sh,conf}]
indent_size = 4

[*.md]
# Markdown 中的行尾双空格是有意义的硬换行，不能裁剪
trim_trailing_whitespace = false

[*.sql]
indent_size = 4
