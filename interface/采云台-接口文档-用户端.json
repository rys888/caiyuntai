          "detail": {
            "type": "string",
            "description": "详细地址",
            "example": "A座12层技术部办公区"
          },
          "deptName": {
            "type": "string",
            "nullable": true,
            "description": "部门名称",
            "example": "技术部"
          },
          "station": {
            "type": "string",
            "nullable": true,
            "description": "工位",
            "example": "A座12层工位03"
          },
          "label": {
            "type": "string",
            "nullable": true,
            "description": "标签",
            "example": "公司"
          },
          "isDefault": {
            "type": "integer",
            "description": "1=默认地址，0=非默认"
          }
        }
      }
    }
  }
}