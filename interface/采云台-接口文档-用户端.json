  "components": {
    "securitySchemes": {
      "UserToken": {
        "type": "apiKey",
        "in": "header",
        "name": "authentication",
        "description": "员工端 JWT。登录 POST /user/user/login 后从 data.token 获取。有效期 7200000ms（2 小时）。任意在职员工均可获取。"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "未登录，或 token 缺失/无效/过期。**HTTP 401，无响应体**。管理端返回 401 的另一种情形：当前账号角色为 EMPLOYEE（普通员工不允许登录管理端）。"
      }
    },
    "schemas": {
      "Result": {
        "type": "object",
        "description": "统一响应包装",
        "properties": {
          "code": {
            "type": "integer",
            "description": "1=成功；0=业务失败",
            "example": 1
          },
          "msg": {
            "type": "string",
            "nullable": true,
            "description": "失败原因，成功时为 null",
            "example": null
          },
          "data": {
            "nullable": true,
            "description": "业务数据，结构随接口而异"
          }
        }
      },
      "PageResult": {
        "type": "object",
        "description": "分页结果包装",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "总记录数",
            "example": 12
          },
          "records": {
            "type": "array",
            "description": "当前页数据集合，元素结构随接口而定",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "EmployeeLoginDTO": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "登录账号",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "description": "登录密码（明文传输，库中存 MD5）",
            "example": "123456"
          }
        }
      },
      "EmployeeLoginVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "userName": {
            "type": "string",
            "description": "登录账号",
            "example": "admin"
          },
          "name": {
            "type": "string",
            "description": "姓名",
            "example": "系统管理员"
          },
          "role": {
            "type": "string",
            "enum": [
              "EMPLOYEE",
              "PURCHASER",
              "ADMIN"
            ],
            "example": "ADMIN"
          },
          "deptId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "example": 2
          },
          "deptName": {
            "type": "string",
            "nullable": true,
            "description": "部门名称，无部门时为 null",
            "example": "技术部"
          },
          "token": {
            "type": "string",
            "description": "JWT 令牌，后续请求放入对应请求头",
            "example": "eyJhbGciOiJIUzI1NiJ9.xxxxx.yyyyy"
          }
        }
      },
      "BudgetVO": {
        "type": "object",
        "description": "员工端未设置预算时 data 为 null",
        "properties": {
          "deptId": {
            "type": "integer",
            "format": "int64"
          },
          "deptName": {
            "type": "string",
            "example": "技术部"
          },
          "period": {
            "type": "string",
            "example": "2026-09"
          },
          "totalAmount": {
            "type": "number",
            "example": 10000.0
          },
          "usedAmount": {
            "type": "number",
            "example": 35.0
          },
          "remainAmount": {
            "type": "number",
            "description": "剩余可用额度 = totalAmount - usedAmount",
            "example": 9965.0
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 23
          },
          "type": {
            "type": "integer",
            "nullable": true
          },
          "name": {
            "type": "string",
            "example": "办公耗材"
          },
          "sort": {
            "type": "integer",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "description": "1=启用，0=停用"
          },
          "createTime": {
            "type": "string",
